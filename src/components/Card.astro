---
import { Picture } from "astro:assets";

export interface Props {
	name: string;
	href: string;
	src: ImageMetadata;
}

const { name, href, src } = Astro.props;
---

<li class="card">
	<a href={href}>
		<Picture
			src={src}
			formats={["avif", "webp"]}
			fallbackFormat="jpeg"
			widths={[192, 384, 576]}
			sizes="(min-width: 40rem) 192px, (min-width: 27rem) 45vw, calc(100vw - 3rem)"
			alt={name}
		/>
	</a>
</li>
<style>
	.card a {
		display: inline-block;
		vertical-align: bottom;
		border: solid 1px #ddd;
	}
	@keyframes card-hover {
		0% {
			outline: solid 0 rgba(var(--accent), 0);
		}
		100% {
			outline: solid 2px rgb(var(--accent));
		}
	}
	.card a:hover,
	.card a:focus {
		outline: solid 2px rgb(var(--accent));
		animation: card-hover 0.2s ease-out 1;
	}
	.card img {
		width: auto;
		height: auto;
		max-width: 100%;
		vertical-align: bottom;
	}
</style>
