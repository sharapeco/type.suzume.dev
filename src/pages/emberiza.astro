---
import Layout from "../layouts/Layout.astro"
import Address from "../components/Address.astro";
import { Picture } from "astro:assets";
import emberizaJt from "../assets/img/emberiza-jt.png";
---

<Layout title="コーディングフォント Emberiza Sans" image={emberizaJt}>
	<main>
		<h1>
			<Picture
				src={emberizaJt}
				formats={["avif", "webp"]}
				fallbackFormat="jpeg"
				widths={[360, 512, 720, 1024, 1280]}
				sizes="(min-width: 100rem) 720px, (min-width: 48rem) calc(512px + 13vw), (min-width: 41.5rem) 612px, calc(100vw - 51px)"
				alt="Emberiza Sans – Fonts for modern coding"
			/>
		</h1>

		<p class="par">
			Emberiza Sans はプロポーショナル幅のコーディング用フォントです。
		</p>
		<p class="par">
			一般的なフォントと異なり、括弧類、引用符、ピリオドやカンマなどが他の文字とくっついて見えないよう、
			左右の余白を広く取っています。
		</p>

		<h2>ライセンス</h2>
		<p>MIT License に従い、誰でも無償で自由に利用できます。</p>

		<h2>ダウンロード</h2>
		<ul class="download-list">
			<li>
				<a class="btn" href="/downloads/EmberizaSans-12-0.201.zip" download>Emberiza Sans 12 v0.201</a>
			</li>
		</ul>
	</main>
	<Address></Address>
</Layout>

<style>
	h1 {
		margin-block-end: 1em;
	}
	h1 picture,
	h1 img {
		display: block;
	}
	h1 img {
		width: 100%;
		height: auto;
	}
	@media (prefers-color-scheme: dark) {
		/* 見本画像は白地なので、暗い背景で浮きすぎないようわずかに落とす */
		h1 img {
			filter: brightness(0.86) contrast(1.02);
		}
	}

	.download-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
		margin-block: 1.5em;
		padding: 0;
		list-style: none;
	}
	.download-list li {
		flex: 1 1 14em;
	}
	.btn {
		display: block;
	}
</style>
