---
import Layout from "../layouts/Layout.astro"
import Address from "../components/Address.astro";
import Card from "../components/Card.astro";
import enokoroSerif from "../assets/img/enokoro-serif.png";
import tsuyukusaMincho from "../assets/img/tsuyukusa-mincho.jpg";
import hakoberaMincho from "../assets/img/hakobera-mincho.jpg";
import oobakoMGothic from "../assets/img/oobako-m-gothic.jpg";
import enokoroSans from "../assets/img/enokoro-sans.png";
import tsuyukusaGothic from "../assets/img/tsuyukusa-gothic.jpg";
import hakoberaKakuGothicA from "../assets/img/hakobera-kaku-gothic-a.jpg";
import hakoberaKakuGothicB from "../assets/img/hakobera-kaku-gothic-b.jpg";
import hakoberaMaruGothicA from "../assets/img/hakobera-maru-gothic-a.jpg";
import hakoberaMaruGothicB from "../assets/img/hakobera-maru-gothic-b.jpg";
import tsuyukusaAntique from "../assets/img/tsuyukusa-antique.jpg";
import klee from "../assets/img/klee.jpg";
import stick from "../assets/img/stick.jpg";
import rocknroll from "../assets/img/rocknroll.jpg";
import reggae from "../assets/img/reggae.jpg";
import train from "../assets/img/train.jpg";
import dotGothic16 from "../assets/img/dot-gothic-16.jpg";
---

<Layout title="日本語組版のためのフォント for Affinity">
	<main>
		<h1>
			<span class="nihongo">日本語組版</span><span class="notameno">のための</span><span class="font">フォント</span>{" "}
			<span class="for-affinity">for Affinity</span>
		</h1>

		<p class="par">
			Serif 社のグラフィックソフト <a href="https://affinity.serif.com">Affinity</a> シリーズでは、フォントに含まれる代替プロポーショナルメトリクスを使用した文字詰めや、漢字字形の切り替え、縦組みなど、日本語組版のための機能を使うことができません。
		</p>
		<p class="par">
			ここで公開しているフォントは、これらの日本語組版のための機能を Affinity から使用できるように変更を加えたものです。
			どなたでも SIL Open Font License 1.1 にしたがい無償でご自由にお使いいただけます。
		</p>

		<ul role="list" class="link-card-grid wide">
			<Card href="https://s-suzume.booth.pm/items/4852495" name="えのころ明朝" src={enokoroSerif} />
			<Card href="https://s-suzume.booth.pm/items/4885587" name="つゆくさ明朝" src={tsuyukusaMincho} />
			<Card href="https://s-suzume.booth.pm/items/4898539" name="はこべら明朝" src={hakoberaMincho} />
			<Card href="https://s-suzume.booth.pm/items/4907999" name="おおばこMゴシック" src={oobakoMGothic} />
			<Card href="https://s-suzume.booth.pm/items/4852466" name="えのころ角ゴシック" src={enokoroSans} />
			<Card href="https://s-suzume.booth.pm/items/5167426" name="つゆくさゴシック" src={tsuyukusaGothic} />
			<Card href="https://s-suzume.booth.pm/items/4898644" name="はこべら角ゴシックA" src={hakoberaKakuGothicA} />
			<Card href="https://s-suzume.booth.pm/items/4898664" name="はこべら角ゴシックB" src={hakoberaKakuGothicB} />
			<Card href="https://s-suzume.booth.pm/items/4898678" name="はこべら丸ゴシックA" src={hakoberaMaruGothicA} />
			<Card href="https://s-suzume.booth.pm/items/4898687" name="はこべら丸ゴシックB" src={hakoberaMaruGothicB} />
			<Card href="https://s-suzume.booth.pm/items/4887266" name="つゆくさアンチック" src={tsuyukusaAntique} />
			<Card href="https://s-suzume.booth.pm/items/4893048" name="クレー One ss/vert" src={klee} />
			<Card href="https://s-suzume.booth.pm/items/4893103" name="ステッキ ss/vert" src={stick} />
			<Card href="https://s-suzume.booth.pm/items/4893095" name="ロックンロール One ss/vert" src={rocknroll} />
			<Card href="https://s-suzume.booth.pm/items/4893088" name="レゲエ One ss/vert" src={reggae} />
			<Card href="https://s-suzume.booth.pm/items/4893112" name="トレイン One ss/vert" src={train} />
			<Card href="https://s-suzume.booth.pm/items/4893080" name="ドットゴシック16 ss/vert" src={dotGothic16} />
		</ul>

		<div class="video">
			<iframe
				src="https://player.vimeo.com/video/835685514?badge=0&autopause=0&player_id=0&app_id=58479"
				allow="autoplay; fullscreen; picture-in-picture"
				allowfullscreen
				title="えのころ角ゴシック、えのころ明朝の紹介"></iframe>
		</div>
		<script is:inline src="https://player.vimeo.com/api/player.js"></script>

		<h2>主な機能</h2>
		<p>フォントにより搭載されている機能は異なります。</p>
		<ul class="par">
			<li>プロポーショナルメトリクス</li>
			<li>連続する約物のアキ調整</li>
			<li>漢字字形選択（JIS78, JIS83, JIS90, 国語審議会2000字形）</li>
			<li>縦組み</li>
		</ul>

		<h2>ライセンス</h2>
		<p>
			<a href="http://scripts.sil.org/cms/scripts/page.php?site_id=nrsi&id=OFL"
				>SIL Open Font License 1.1</a
			>（<a href="https://ja.osdn.net/projects/opensource/wiki/SIL_Open_Font_License_1.1"
				>日本語訳</a
			>）
		</p>

		<h2>注意すべき仕様</h2>
		<p class="par">
			縦組用の vert フォントは Adobe InDesign/Illustrator とは正立する文字が異なり、ウェブブラウザで <code>writing-mode: vertical-rl</code> を設定したときと近い動作をします。
			これらのアプリケーションで使用している原稿を流用する際はご注意ください。
		</p>
		<ul class="par">
			<li>正立: ⁑ ⁂ † § ‼ ⁇ ⁈ ⁉</li>
			<li>横倒し: ＜ ＞ ； € 〰</li>
			<li>矢印の向きが書字方向に依存します。つまり ← は ↑ の向きに見えます</li>
			<li>3点リーダ（…）は左寄りではなく中央に配置されます</li>
		</ul>

		<h2>既知の不具合</h2>
		<ul class="par">
			<li>
				不具合があれば <a href="https://twitter.com/stsuzume">@stsuzume</a> までお知らせください
			</li>
		</ul>

		<h2>リリースノート</h2>
		<ul class="par">
			<li>2023-06-17 v1.2.1 Windows で複数のウェイトをインストールできない不具合を修正</li>
			<li>2023-06-13 v1.2.0 Affinity 向けに最適化。vert の不具合を修正</li>
			<li>2023-04-03 v1.0.0 縦書き時の不具合を修正し、バージョン番号を 1.0.0 としました</li>
			<li>2023-04-01 プロポーショナルメトリクスを固定した palt と vert の初版リリース</li>
		</ul>

		<h2>今後の予定</h2>
		<ul class="par">
			<li>必要のないフィーチャーやグリフを削除してファイルサイズを軽量化する</li>
			<li>お手持ちのフォントに同様の変換を行うサービスを公開する</li>
		</ul>
	</main>
	<Address></Address>
</Layout>

<style>
	/* h1 は文字種ごとに見た目の大きさを揃えるため、比率を手で調整している */
	h1 {
		word-spacing: -0.08em;
	}

	.nihongo {
		margin-left: -0.08em;
		display: inline-block;
		font-size: 93%;
	}
	.notameno {
		display: inline-block;
		font-size: 80%;
	}
	.font {
		display: inline-block;
		font-size: 93.5%;
		letter-spacing: -0.028em;
	}
	.for-affinity {
		display: inline-block;
		font-size: 93%;
		letter-spacing: -0.025em;
	}

	.link-card-grid {
		display: grid;
		/* 狭い画面で1列＝巨大カードにならないよう、列の最小幅を 45% で頭打ちにする */
		grid-template-columns: repeat(auto-fill, minmax(min(13em, 45%), 1fr));
		gap: 0.75em;
		margin-block: 2.5em;
		padding: 0;
		list-style: none;
	}

	.video {
		position: relative;
		margin-block: 2.5em;
		padding-block-start: 60%;
	}
	.video iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		border-radius: 0.4em;
	}
</style>
