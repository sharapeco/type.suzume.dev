---
import Layout from "../layouts/Layout.astro"
import Address from "../components/Address.astro";
import { Picture } from "astro:assets";
import forAffinityJt from "../assets/img/for-affinity-jt.png";
import emberizaJt from "../assets/img/emberiza-jt.png";
---

<Layout title="type.suzume.dev">
	<main>
		<h1>type.suzume.dev</h1>

		<nav>
			<div class="nav-item">
				<a href="/for-affinity/">
					<Picture
						src={forAffinityJt}
						formats={["avif", "webp"]}
						fallbackFormat="jpeg"
						widths={[360, 512, 720, 1024, 1280]}
						sizes="(min-width: 100rem) 720px, (min-width: 48rem) calc(512px + 13vw), (min-width: 41.5rem) 612px, calc(100vw - 51px)"
						alt="日本語組版するためのフォント for Affinity"
					/>
				</a>
			</div>
			<div class="nav-item">
				<a href="/emberiza/">
					<Picture
						src={emberizaJt}
						formats={["avif", "webp"]}
						fallbackFormat="jpeg"
						widths={[360, 512, 720, 1024, 1280]}
						sizes="(min-width: 100rem) 720px, (min-width: 48rem) calc(512px + 13vw), (min-width: 41.5rem) 612px, calc(100vw - 51px)"
						alt="コーディングフォント Emberiza Sans"
					/>
				</a>
			</div>
		</nav>
 	</main>

	<Address></Address>
</Layout>

<style>
	h1 {
		letter-spacing: -0.025em;
	}
	nav {
		margin-block: 1.5em;
	}
	.nav-item {
		margin-block-end: 1em;
	}
	.nav-item a {
		display: block;
		background: var(--surface);
		border: solid 1px var(--border);
		border-radius: 0.4em;
		overflow: hidden;
		text-decoration: none;
		transition: border-color 0.15s ease-out;
	}
	.nav-item a:hover,
	.nav-item a:focus-visible {
		border-color: var(--accent);
	}
	.nav-item picture,
	.nav-item img {
		display: block;
	}
	.nav-item img {
		width: 100%;
		height: auto;
	}
	@media (prefers-color-scheme: dark) {
		/* 見本画像はすべて白地なので、暗い背景で浮きすぎないようわずかに落とす */
		.nav-item img {
			filter: brightness(0.86) contrast(1.02);
		}
	}
</style>
